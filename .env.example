# ──────────────────────────────────────────────────────────────────────────────
# MotoStock — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como '.env' y ajusta los valores antes de arrancar.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Configuración de Entorno General ─────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── PostgreSQL Database ──────────────────────────────────────────────────────
# Valores para la conexión y la inicialización de la base de datos
POSTGRES_USER=motostock
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=motostock
DATABASE_URL=postgresql://motostock:CHANGE_ME_STRONG_PASSWORD@db:5432/motostock

# ─── FastAPI / JWT Security ────────────────────────────────────────────────────
# SECRET_KEY: Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_TO_NEW_STRONG_SECRET_KEY_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ENCRYPTION_KEY: Clave Fernet de 32 bytes codificada en URL base64 para encriptar
# datos sensibles. Genera una con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_TO_FERNET_KEY_44_CHARS

# ─── CORS Configuration ────────────────────────────────────────────────────────
# Lista de dominios permitidos separados por comas (sin espacios)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173

# ─── Redis (Caché y Rate Limiting) ─────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# ─── Twilio (Notificaciones de WhatsApp y SMS para Cambios de Aceite) ──────────
# Opcional en desarrollo. Registro en https://www.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_secure_auth_token_here
TWILIO_FROM_NUMBER=+15005550006
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Frontend Configuration (Vite) ────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=MotoStock
VITE_APP_VERSION=1.0.0

# ─── Copias de Seguridad Automáticas ──────────────────────────────────────────
BACKUP_INTERVAL_HOURS=12
BACKUP_RETENTION_DAYS=30
BACKUP_EMAIL=dueno@correo.com
REPORT_EMAIL=dueno@correo.com

# ─── Facturación Electrónica DIAN / Siigo (Colombia) ─────────────────────────
# Nota: La facturación real está pausada. Por defecto se usa el mock local.
DIAN_ENV=habilitacion
DIAN_PROVIDER=mock
DIAN_CERT_PATH=./certs/cert.p12
DIAN_CERT_PASSWORD=your_cert_password
DIAN_NIT=900123456-7
DIAN_RESOLUTION=18760000001
DIAN_INVOICE_PREFIX=FV
SIIGO_API_BASE_URL=https://api.siigo.com
SIIGO_API_TOKEN=your_siigo_token

# ─── Email Configuration (SMTP para reportes y backups) ──────────────────────
# Utiliza contraseñas de aplicación si usas Gmail o Google Workspace
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@yourdomain.com
SMTP_PASSWORD=your_app_specific_password

# ─── Monitoreo (Grafana + Prometheus) ─────────────────────────────────────────
PROMETHEUS_ENABLED=true
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD_16_CHARS

# ─── Autenticación 2FA (Double Factor Auth) ───────────────────────────────────
TWO_FA_ENABLED=true
TWO_FA_ISSUER=MotoStock
TWO_FA_DIGITS=6
TWO_FA_PERIOD=30

# ─── Sentry / Observability (APM) ─────────────────────────────────────────────
SENTRY_DSN=
VITE_SENTRY_DSN=
